# ClimbOS environment variables.
# Copy to .env.local for local development. Never commit real values.
# `pnpm setup:check` reports which values are missing (it never prints secrets).
# `pnpm env:sync` copies the server-side values below into the Convex deployment.

# ---------------------------------------------------------------------------
# Next.js (browser-visible values must start with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CONVEX_URL=            # written by `npx convex dev`
NEXT_PUBLIC_CONVEX_SITE_URL=       # written by `npx convex dev`
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_POSTHOG_KEY=           # optional: ClimbOS product analytics (no session replay)
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Shared secret between the Next.js server and Convex for server-only calls
# (landing-page preview rate limiting, OAuth callbacks). Generate: openssl rand -hex 32
CLIMBOS_SERVER_SECRET=

# ---------------------------------------------------------------------------
# Convex deployment environment (set with `npx convex env set NAME value`
# or `pnpm env:sync`). These are read only inside Convex functions.
# ---------------------------------------------------------------------------
SITE_URL=http://localhost:3000
# JWT_PRIVATE_KEY / JWKS are generated by `pnpm auth:keys` and set in Convex directly.

# Operators allowed into /ops (comma-separated, lowercase)
OPS_EMAILS=faisalibnislam@gmail.com

# AI providers (server only)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Platform transactional email (sign-in codes, invitations, alerts, digests)
AUTH_RESEND_KEY=
RESEND_FROM="ClimbOS <hello@climbos.app>"
RESEND_WEBHOOK_SECRET=             # whsec_... from the Resend webhook settings

# Google sign-in (optional; the button appears automatically once both are set in Convex)
# Redirect URIs: https://climbos.app/api/auth/callback/google and http://localhost:3000/api/auth/callback/google
CUSTOM_AUTH_SITE_URL=http://localhost:3000   # prod: https://climbos.app (OAuth runs on our domain)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Polar billing. Use the sandbox until you are ready for real payments.
POLAR_SERVER=sandbox               # sandbox | production
POLAR_ACCESS_TOKEN=                # organization access token
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_BASIC=
POLAR_PRODUCT_STARTER=
POLAR_PRODUCT_GROWTH=
POLAR_PRODUCT_PRO=
POLAR_PRODUCT_BUSINESS=
POLAR_PRODUCT_BOOST_29=

# Encryption key for connector tokens (32 bytes, base64). Generate: openssl rand -base64 32
# Rotation: move the old value to CLIMBOS_ENCRYPTION_KEY_PREVIOUS and set a new key id.
CLIMBOS_ENCRYPTION_KEY=
CLIMBOS_ENCRYPTION_KEY_ID=k1
CLIMBOS_ENCRYPTION_KEY_PREVIOUS=

# Optional research providers
FIRECRAWL_API_KEY=                 # falls back to the built-in bounded fetcher when blank
GOOGLE_PAGESPEED_API_KEY=          # optional; rate-limit/project attribution for mobile Lighthouse checks
GOOGLE_CRUX_API_KEY=               # optional; Chrome UX Report real-user metrics in conversion audits

# Optional Cloudflare R2 object storage (falls back to Convex file storage when blank)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=climbos-assets

# Integration developer apps (all optional; missing values show "Setup needed")
GOOGLE_OAUTH_CLIENT_ID=            # GA4, Search Console, Google Ads
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_ACCESS_LEVEL=           # test | explorer | basic | standard
META_APP_ID=                       # Facebook Pages, Instagram, Meta Ads
META_APP_SECRET=
META_ADS_ACCESS_TIER=              # limited | full
INSTAGRAM_APP_ID=                  # Instagram API with Instagram Login
INSTAGRAM_APP_SECRET=
LINKEDIN_CLIENT_ID=                 # LinkedIn publishing
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=                        # X publishing
X_CLIENT_SECRET=

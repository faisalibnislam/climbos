!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

!.env.example

# test artifacts
playwright-report/
test-results/

# Benchmark caches
bench/cache/

# Reference books (copyrighted source EPUBs; read locally, never committed)
docs/reference-books/*.epub
docs/reference-books/*.pdf
docs/reference-books-2/*.epub
docs/reference-books-2/*.pdf

